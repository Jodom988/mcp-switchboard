{
	"name": "mcp-switchboard",
	"version": "1.0.0",
	"description": "A system for organizing and managing MCP (Model Context Protocol) Servers",
	"main": "dist/daemon/index.js",
	"scripts": {
		"build": "bun build src/daemon/index.ts src/cli/index.ts --outdir dist --target node --splitting",
		"start": "bun dist/daemon/index.js",
		"dev": "bun run src/daemon/index.ts",
		"verify": "bun run test && bun run test:integration && prettier --check --config ../.prettierrc.json .",
		"test": "vitest run src",
		"test:integration": "vitest run test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Jodom988/mcp-switchboard.git"
	},
	"keywords": [],
	"author": "Josh Majors",
	"license": "ISC",
	"type": "module",
	"bugs": {
		"url": "https://github.com/Jodom988/mcp-switchboard/issues"
	},
	"homepage": "https://github.com/Jodom988/mcp-switchboard#readme",
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.28.0",
		"commander": "^14.0.3",
		"express": "^5.2.1",
		"micromatch": "^4.0.8",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@types/express": "^5.0.6",
		"@types/micromatch": "^4.0.10",
		"@types/node": "^25.5.0",
		"prettier": "^3.8.1",
		"test-servers": "file:../test-servers",
		"typescript": "^6.0.2",
		"vitest": "^4.1.2"
	}
}
